{"$id":"skillscope.audit-result/v1","$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"description":"Output contract of the T006 resolver kernel (src/resolver AuditResult): the normalised instances, findings and coverage for one host audit, in the form T009 (CLI) serialises. Instance ids are canonical audit keys \"<sourceRootId>:<relativePath>\" — portable across machines, never absolute paths.","properties":{"botId":{"description":"Bot id, OpenMausBot only.","minLength":1,"type":"string"},"coverage":{"additionalProperties":false,"properties":{"enumeratedSources":{"minimum":0,"type":"integer"},"requiredSources":{"minimum":0,"type":"integer"},"unknownScopes":{"items":{"minLength":1,"type":"string"},"type":"array"}},"required":["enumeratedSources","requiredSources","unknownScopes"],"type":"object"},"engine":{"enum":["codex","claude-code","openmausbot"],"type":"string"},"findings":{"description":"Normalised findings (frozen §5.2 taxonomy), sorted and deduplicated.","items":{"additionalProperties":false,"properties":{"affectedCount":{"minimum":0,"type":"integer"},"detail":{"type":"string"},"id":{"enum":["SCOPE_LEAK","DISABLE_MISMATCH","NAME_SELECTOR_BLAST_RADIUS","SAME_NAME_COLLISION","FAIL_OPEN_CONFIG","SOURCE_NOT_ENUMERATED","IMPORT_ORIGINAL_PATH_STILL_ACTIVE","SYMLINK_ALIAS","SYMLINK_OUTSIDE_ROOT","INVALID_MANIFEST","DUPLICATE_CONTENT"],"type":"string"},"instanceIds":{"items":{"minLength":1,"type":"string"},"type":"array"},"severity":{"enum":["P1","P2"],"type":"string"},"sourceScope":{"minLength":1,"type":"string"},"status":{"enum":["CONFIRMED","UNKNOWN"],"type":"string"}},"required":["id","severity","sourceScope","status","detail","instanceIds"],"type":"object"},"type":"array"},"instances":{"description":"Normalised instances, sorted by (sourceRootId, relativePath).","items":{"additionalProperties":false,"properties":{"aliases":{"items":{"minLength":1,"type":"string"},"type":"array"},"contentSha256":{"pattern":"^[0-9a-f]{64}$","type":"string"},"evidenceLevel":{"enum":["STATIC_RULE","HOST_SNAPSHOT","RUNTIME_OBSERVED"],"type":"string"},"folderName":{"minLength":1,"type":"string"},"instanceId":{"minLength":1,"type":"string"},"logicalName":{"minLength":1,"type":"string"},"manifestName":{"minLength":1,"type":"string"},"relativePath":{"minLength":1,"type":"string"},"sourceRootId":{"minLength":1,"type":"string"},"sourceScope":{"minLength":1,"type":"string"},"status":{"enum":["DISCOVERED","ELIGIBLE","DISABLED","UNKNOWN","INVALID"],"type":"string"}},"required":["instanceId","sourceRootId","sourceScope","relativePath","logicalName","folderName","contentSha256","status","evidenceLevel","aliases"],"type":"object"},"type":"array"},"policy":{"additionalProperties":false,"properties":{"applied":{"type":"boolean"},"effectiveCount":{"minimum":0,"type":"integer"},"expectedCount":{"minimum":0,"type":"integer"},"normalized":{"additionalProperties":false,"description":"Normalised PolicyV1 (camelCase) when a policy was applied, else null.","properties":{"allowedScopes":{"items":{"minLength":1,"type":"string"},"type":"array"},"forbiddenNames":{"items":{"minLength":1,"type":"string"},"type":"array"},"forbiddenScopes":{"items":{"minLength":1,"type":"string"},"type":"array"}},"type":["object","null"]},"violationCount":{"minimum":0,"type":"integer"}},"required":["applied","normalized","effectiveCount","expectedCount","violationCount"],"type":"object"},"profileId":{"minLength":1,"type":"string"},"schema":{"const":"skillscope.audit-result/v1","description":"Contract version. Any other value is an unknown audit-result version."},"status":{"enum":["PASS","FAIL","INCOMPLETE"],"type":"string"}},"required":["schema","profileId","engine","status","instances","findings","coverage","policy"],"title":"SkillScope unified audit result (v1)","type":"object"}